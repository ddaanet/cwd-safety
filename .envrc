source_up_if_exists
PATH_add .gitlore/bin

# Dev tooling from uv.lock (`uv sync` once): rumdl, see pyproject.toml.
export VIRTUAL_ENV=$PWD/.venv
PATH_add .venv/bin

# `claude` shim: launches with `--plugin-dir <repo root>` so the in-tree
# plugin is active. Last PATH_add wins, keeping it ahead of .gitlore/bin.
PATH_add .bin
